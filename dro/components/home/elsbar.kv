#: import RetroProgressBar dro.components.widgets.progress_bar.RetroProgressBar
#: import Factory kivy.factory.Factory
#: import FeedsTablePopup dro.components.popups.feeds_table_popup
#: import AutoSizeButton dro.components.widgets.auto_size_button

<ElsBar>:
  orientation: "horizontal"
  size_hint_y: None
  height: 128

  Button:
    width: 96
    size_hint_x: None
    text: app.servo.name
    font_size: self.height / 1.5
    font_style: "bold"
    background_color: [0.2, 1, 0.2, 1] if app.servo.servoEnable else [0.3, 0.3, 0.3, 1]
    on_release: root.toggle_servo()

  # Thread hand / feed direction. Same width as the other controls for a consistent touch
  # target. Locked out while the servo runs: flipping it mid-cut would reverse the carriage
  # into the work.
  BoxLayout:
    width: self.height
    size_hint_x: None
    orientation: 'vertical'
    Label:
      text: "Hand"
      font_size: self.height / 1.5
      size_hint_y: 0.3
      color: app.formats.display_color
      halign: 'center'
      valign: 'top'
    Button:
      size_hint_y: 0.7
      font_name: app.formats.font_name
      font_size: self.height / 2
      font_style: "bold"
      background_color: [0.3, 0.3, 0.3, 1]
      color: app.formats.display_color
      text: "LH" if root.feed_direction < 0 else "RH"
      text_size: self.size
      halign: 'center'
      valign: 'middle'
      disabled: app.servo.servoEnable != 0
      on_release: root.toggle_feed_direction()

  BoxLayout:
    orientation: "vertical"
    size_hint_x: 0.8
    # Row heights sum to 1.0 so Kivy doesn't renormalise them: the caption then gets the
    # same 0.3 share as the mode/hand captions and lines up with them across the bar.
    Label:
      text: "Current"
      text_size: self.size
      size_hint_y: 0.3
      font_size: self.height / 1.5
      color: app.formats.display_color
      halign: 'center'
      valign: 'top'
    AutoSizeButton:
      size_hint_y: 0.5
      font_name: app.formats.font_name
      # Matches the feed/hand value buttons, which work out to (0.7 * bar) / 2. Expressed
      # against the bar rather than self.height because this row is shorter — it gives up
      # space to the speed bar below. AutoSizeButton still shrinks it if the text is wide.
      max_font_size: root.height * 0.35
      font_style: "bold"
      background_color: [0.2, 0.2, 0.2, 1]
      color: app.formats.display_color
      text: app.servo.formattedPosition + "\u00b0"
      text_size: self.size
      halign: 'center'
      valign: 'middle'
      disabled: app.servo.disableControls
      on_release: app.servo.update_current_position()
    RetroProgressBar:
      size_hint_y: 0.20
      max: int(app.servo.maxSpeed)
      value: int(abs(app.servo.speed))
      fill_color: app.formats.display_color

  Button:
    width: self.height
    size_hint_x: None
    font_name: "fonts/Font Awesome 6 Free-Solid-900.otf"
    text: "\uf060"
    text_halign: "center"
    font_size: self.height / 4
    font_style: "bold"
    halign: "center"
    on_release: root.previous_feed()

  BoxLayout:
    width: self.height
    size_hint_x: None
    orientation: 'vertical'
    Label:
      text: root.mode_name
      font_size: self.height / 1.5
      size_hint_y: 0.3
      color: app.formats.display_color
      halign: 'center'
      valign: 'top'
    Button:
      size_hint_y: 0.7
      font_name: app.formats.font_name
      font_size: self.height / 2
      font_style: "bold"
      background_color: [0.3, 0.3, 0.3, 1]
      color: app.formats.display_color
      text: root.feed_name
      text_size: self.size
      halign: 'center'
      valign: 'middle'
      on_release: Factory.FeedsTablePopup().show_with_callback(root.set_feed_ratio, custom_fn=root.set_custom_feed)

  Button:
    width: self.height
    size_hint_x: None
    font_name: "fonts/Font Awesome 6 Free-Solid-900.otf"
    text: "\uf061"
    text_halign: "center"
    font_size: self.height / 4
    font_style: "bold"
    halign: "center"
    on_release: root.next_feed()

